rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requesting user authenticated as this uid?
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profiles — only owner can read/write
    match /profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Certificates — only owner can read/write their own certificates.
    // The create rule requires the submitted uid field to match the caller's UID
    // to prevent a client from creating a certificate attributed to another user.
    match /certificates/{certId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
    }

    // Job scores — only owner
    match /jobScores/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Career recommendations — only owner
    match /careerRecommendations/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Skill gap reports — only owner
    match /skillGapReports/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Learning progress — only owner
    match /learningProgress/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Chat history — only owner
    match /chatHistory/{uid}/conversations/{convId} {
      allow read, write: if isOwner(uid);
    }

    // Notifications — only owner
    match /notifications/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // Readiness score history — only owner
    match /readinessHistory/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Resumes ATS scans & versions — only owner
    match /resumes/{uid}/versions/{versionId} {
      allow read, write: if isOwner(uid);
    }

    // Mock technical assessments records — only owner
    match /assessments/{uid}/records/{recordId} {
      allow read, write: if isOwner(uid);
    }

    // AI Mock Interview sessions — only owner
    match /interviews/{uid}/sessions/{sessionId} {
      allow read, write: if isOwner(uid);
    }

    // Mock test attempts (Phase 6 expanded schema) — only owner
    // Stored under: users/{uid}/mockTests/{attemptId}
    match /users/{uid}/mockTests/{attemptId} {
      allow read, write: if isOwner(uid);
    }

    // Default deny — deny all reads/writes not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
